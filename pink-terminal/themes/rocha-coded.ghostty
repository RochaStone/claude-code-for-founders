# Rocha Coded: hot pink paper, ink text. Ghostty theme.
# Either paste these lines into ~/.config/ghostty/config,
# or save this file as ~/.config/ghostty/themes/rocha-coded and add: theme = rocha-coded
background = #FFE1EC
foreground = #111111
cursor-color = #FF2D8A
cursor-text = #FFFFFF
selection-background = #FFB3D1
selection-foreground = #111111
palette = 0=#111111
palette = 1=#E0202E
palette = 2=#1E7A4C
palette = 3=#A87A1E
palette = 4=#4A1033
palette = 5=#FF2D8A
palette = 6=#2E6E8E
palette = 7=#F6EFE4
palette = 8=#6B5A62
palette = 9=#FF4F5E
palette = 10=#2E9A63
palette = 11=#D4A64A
palette = 12=#7A2357
palette = 13=#FF6FAE
palette = 14=#BFD4EA
palette = 15=#FFFFFF
